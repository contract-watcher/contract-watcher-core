{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "DbConnections": {
    "Postgres": {
      "ConnectionString": "User ID=postgres;Password=postgres;Host=postgres-db;Port=55432;Database=core;Pooling=true;Include Error Detail=true",
      "MaxRetry": 6,
      "MaxDelaySec": 30
    }
  },
  "Jwt": {
    "Issuer": "contract-watcher-core",
    "Audience": "contract-watcher",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Monitoring": {
    "BaseUrl": "http://monitoring:8080",
    "PollIntervalSeconds": 5,
    "BatchSize": 100,
    "RequestTimeoutSeconds": 10,
    "MaxDeliveryAttempts": 10,
    "RetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 600,
    "ParkedRetryHours": 24,
    "BreakerThreshold": 5,
    "BreakerWindowSeconds": 60,
    "BreakerDelaySeconds": 10,
    "MaxBreakerDelaySeconds": 300
  },
  "Smtp": {
    "Host": "smtp.yandex.com",
    "Port": 465,
    "Security": "SslOnConnect",
    "Username": "jinx.httpserver@yandex.ru",
    "Password": "",
    "FromAddress": "jinx.httpserver@yandex.ru",
    "FromName": "Contract Watcher",
    "TimeoutSeconds": 30
  },
  "Notifications": {
    "FrontendBaseUrl": "http://localhost:5174",
    "PollIntervalSeconds": 10,
    "BatchSize": 50,
    "DigestIntervalMinutes": 60,
    "MaxSendAttempts": 10,
    "RetryDelaySeconds": 60,
    "MaxRetryDelaySeconds": 3600,
    "EmailConfirmationLifetimeHours": 24
  }
}