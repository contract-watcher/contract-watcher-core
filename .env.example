# Ключ подписи JWT (HS256), не короче 32 символов. Обязателен вне Development: без него приложение не запустится
Jwt__SigningKey=

# Адрес Monitoring для доставки отчётов. Без переменной используется http://monitoring:8080 — имя сервиса в docker compose
# Monitoring__BaseUrl=http://monitoring:8080

# Пароль приложения ящика jinx.httpserver@yandex.ru (Яндекс ID → Пароли приложений). Остальные настройки почты — в appsettings.json.
# Без пароля письма копятся в очереди и не отправляются, в том числе при разработке
Smtp__Password=

# Адрес фронта для ссылок в письмах
# Notifications__FrontendBaseUrl=https://watcher.example.com
